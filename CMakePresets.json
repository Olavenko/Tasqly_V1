{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "default-debug",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "default-release",
      "inherits": "default-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "mingw-debug",
      "inherits": "default-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_PREFIX_PATH": "$env{QT_PATH}"
      }
    },
    {
      "name": "mingw-release",
      "inherits": "default-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_PREFIX_PATH": "$env{QT_PATH}"
      }
    },

    {
      "name": "gcc-debug",
      "inherits": "default-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "default-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],

  "buildPresets": [
    { "name": "build-mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "build-mingw-release", "configurePreset": "mingw-release" },
    { "name": "build-gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "build-clang-debug", "configurePreset": "clang-debug" }
  ],

  "testPresets": [
    { "name": "test-mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "test-mingw-release", "configurePreset": "mingw-release" },
    { "name": "test-gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "test-clang-debug", "configurePreset": "clang-debug" }
  ]
}
