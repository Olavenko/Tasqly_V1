{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "default-debug",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QT_FORCE_CMP0156_TO_VALUE": "NEW"
      }
    },
    {
      "name": "default-release",
      "inherits": "default-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "gcc-debug",
      "inherits": "default-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "TASQLY_BUILD_TESTS": "ON",
        "TASQLY_BUILD_BENCHMARKS": "OFF",
        "TASQLY_BUILD_REPORTS": "OFF"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "default-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "TASQLY_BUILD_TESTS": "ON",
        "TASQLY_BUILD_BENCHMARKS": "OFF",
        "TASQLY_BUILD_REPORTS": "OFF"
      }
    },
    {
      "name": "gcc-coverage",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-coverage",
      "cacheVariables": {
        "ENABLE_COVERAGE": "ON",
        "TASQLY_BUILD_REPORTS": "ON"
      }
    },
    {
      "name": "gcc-sanitizers",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-sanitizers",
      "cacheVariables": {
        "SANITIZERS": "ON"
      }
    },
    {
      "name": "gcc-benchmarks",
      "inherits": "default-release",
      "binaryDir": "${sourceDir}/build/gcc-benchmarks",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "TASQLY_BUILD_TESTS": "OFF",
        "TASQLY_BUILD_BENCHMARKS": "ON",
        "TASQLY_BUILD_REPORTS": "OFF"
      }
    },
    {
      "name": "clang-benchmarks",
      "inherits": "default-release",
      "binaryDir": "${sourceDir}/build/clang-benchmarks",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "TASQLY_BUILD_TESTS": "OFF",
        "TASQLY_BUILD_BENCHMARKS": "ON",
        "TASQLY_BUILD_REPORTS": "OFF"
      }
    },
    {
      "name": "clang-sanitizers",
      "inherits": "clang-debug",
      "binaryDir": "${sourceDir}/build/clang-sanitizers",
      "cacheVariables": {
        "SANITIZERS": "ON"
      }
    },

    {
      "name": "mingw-debug",
      "inherits": "default-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_PREFIX}",
        "TASQLY_BUILD_TESTS": "ON",
        "TASQLY_BUILD_BENCHMARKS": "OFF",
        "TASQLY_BUILD_REPORTS": "OFF"
      },
      "environment": {
        "PATH": "$env{MINGW64_BIN};$penv{PATH}"
      }
    },
    {
      "name": "mingw-release",
      "inherits": "default-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_PREFIX}",
        "TASQLY_BUILD_TESTS": "OFF",
        "TASQLY_BUILD_BENCHMARKS": "OFF",
        "TASQLY_BUILD_REPORTS": "OFF"
      },
      "environment": {
        "PATH": "$env{MINGW64_BIN};$penv{PATH}"
      }
    },
    {
      "name": "mingw-tests-reports-debug",
      "inherits": "mingw-debug",
      "cacheVariables": {
        "TASQLY_BUILD_TESTS": "ON",
        "TASQLY_BUILD_BENCHMARKS": "OFF",
        "TASQLY_BUILD_REPORTS": "ON"
      }
    },
    {
      "name": "mingw-tests-reports-release",
      "inherits": "mingw-release",
      "cacheVariables": {
        "TASQLY_BUILD_TESTS": "ON",
        "TASQLY_BUILD_BENCHMARKS": "OFF",
        "TASQLY_BUILD_REPORTS": "ON"
      }
    },
    {
      "name": "mingw-benchmarks-release",
      "inherits": "mingw-release",
      "cacheVariables": {
        "TASQLY_BUILD_TESTS": "OFF",
        "TASQLY_BUILD_BENCHMARKS": "ON",
        "TASQLY_BUILD_REPORTS": "OFF"
      }
    },

    {
      "name": "msvc-debug",
      "inherits": "default-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/msvc.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{CMAKE_PREFIX_PATH}",
        "TASQLY_BUILD_TESTS": "ON",
        "TASQLY_BUILD_BENCHMARKS": "OFF",
        "TASQLY_BUILD_REPORTS": "OFF"
      },
      "environment": {
        "PATH": "$env{CMAKE_PREFIX_PATH}/bin;$penv{PATH}"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "default-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/msvc.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{CMAKE_PREFIX_PATH}",
        "TASQLY_BUILD_TESTS": "OFF",
        "TASQLY_BUILD_BENCHMARKS": "ON",
        "TASQLY_BUILD_REPORTS": "OFF"
      },
      "environment": {
        "PATH": "$env{CMAKE_PREFIX_PATH}/bin;$penv{PATH}"
      }
    },
    {
      "name": "msvc-tests-reports-debug",
      "inherits": "msvc-debug",
      "cacheVariables": {
        "TASQLY_BUILD_TESTS": "ON",
        "TASQLY_BUILD_BENCHMARKS": "OFF",
        "TASQLY_BUILD_REPORTS": "ON"
      }
    },
    {
      "name": "msvc-tests-reports-release",
      "inherits": "msvc-release",
      "cacheVariables": {
        "TASQLY_BUILD_TESTS": "ON",
        "TASQLY_BUILD_BENCHMARKS": "OFF",
        "TASQLY_BUILD_REPORTS": "ON"
      }
    },
    {
      "name": "msvc-benchmarks-release",
      "inherits": "msvc-release",
      "cacheVariables": {
        "TASQLY_BUILD_TESTS": "OFF",
        "TASQLY_BUILD_BENCHMARKS": "ON",
        "TASQLY_BUILD_REPORTS": "OFF"
      }
    },
    {
      "name": "msvc-benchmarks-reports-debug",
      "inherits": "msvc-debug",
      "cacheVariables": {
        "TASQLY_BUILD_TESTS": "OFF",
        "TASQLY_BUILD_BENCHMARKS": "ON",
        "TASQLY_BUILD_REPORTS": "ON"
      }
    },
    {
      "name": "msvc-benchmarks-reports-release",
      "inherits": "msvc-release",
      "cacheVariables": {
        "TASQLY_BUILD_TESTS": "OFF",
        "TASQLY_BUILD_BENCHMARKS": "ON",
        "TASQLY_BUILD_REPORTS": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "build-gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "build-clang-debug", "configurePreset": "clang-debug" },
    { "name": "build-gcc-coverage", "configurePreset": "gcc-coverage" },
    { "name": "build-gcc-sanitizers", "configurePreset": "gcc-sanitizers" },
    { "name": "build-clang-sanitizers", "configurePreset": "clang-sanitizers" },
    { "name": "build-gcc-benchmarks", "configurePreset": "gcc-benchmarks" },
    { "name": "build-clang-benchmarks", "configurePreset": "clang-benchmarks" },

    { "name": "build-mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "build-mingw-release", "configurePreset": "mingw-release" },
    { "name": "build-mingw-tests-reports-debug", "configurePreset": "mingw-tests-reports-debug" },
    { "name": "build-mingw-tests-reports-release", "configurePreset": "mingw-tests-reports-release" },
    { "name": "build-mingw-benchmarks-release", "configurePreset": "mingw-benchmarks-release" },

    { "name": "build-msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "build-msvc-release", "configurePreset": "msvc-release" },
    { "name": "build-msvc-tests-reports-debug", "configurePreset": "msvc-tests-reports-debug" },
    { "name": "build-msvc-tests-reports-release", "configurePreset": "msvc-tests-reports-release" },
    { "name": "build-msvc-benchmarks-release", "configurePreset": "msvc-benchmarks-release" },
    { "name": "build-msvc-benchmarks-reports-debug", "configurePreset": "msvc-benchmarks-reports-debug" },
    { "name": "build-msvc-benchmarks-reports-release", "configurePreset": "msvc-benchmarks-reports-release" }
  ],

  "testPresets": [
    {
      "name": "test-gcc-debug",
      "configurePreset": "gcc-debug",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "TasqlyTests.*" } }
    },
    {
      "name": "test-clang-debug",
      "configurePreset": "clang-debug",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "TasqlyTests.*" } }
    },
    {
      "name": "test-gcc-coverage",
      "configurePreset": "gcc-coverage",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "TasqlyTests.*" } }
    },
    {
      "name": "test-gcc-sanitizers",
      "configurePreset": "gcc-sanitizers",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "TasqlyTests.*" } }
    },
    {
      "name": "test-clang-sanitizers",
      "configurePreset": "clang-sanitizers",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "TasqlyTests.*" } }
    },
    {
      "name": "test-mingw-debug",
      "configurePreset": "mingw-debug",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "TasqlyTests.*" } },
      "execution": { "noTestsAction": "error" },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QSG_RHI_BACKEND": "software",
        "CTEST_TEST_TIMEOUT": "0",
        "GTEST_PRINT_TIME": "1"
      }
    },
    {
      "name": "test-mingw-release",
      "configurePreset": "mingw-release",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "TasqlyTests.*" } },
      "execution": { "noTestsAction": "error" },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QSG_RHI_BACKEND": "software",
        "CTEST_TEST_TIMEOUT": "0",
        "GTEST_PRINT_TIME": "1"
      }
    },

    {
      "name": "test-msvc-debug",
      "configurePreset": "msvc-debug",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "TasqlyTests.*" } },
      "execution": { "noTestsAction": "error" },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QSG_RHI_BACKEND": "software",
        "GTEST_PRINT_TIME": "1"
      }
    },
    {
      "name": "test-msvc-release",
      "configurePreset": "msvc-release",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "TasqlyTests.*" } },
      "execution": { "noTestsAction": "error" },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QSG_RHI_BACKEND": "software",
        "GTEST_PRINT_TIME": "1"
      }
    }
  ]
}
