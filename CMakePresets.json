{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "default-debug",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "default-release",
      "inherits": "default-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "mingw-debug",
      "inherits": "default-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "$env{QT_PREFIX}"
      },
      "environment": {
        "PATH": "C:/msys64/mingw64/bin;$penv{PATH}"
      }
    },
    {
      "name": "mingw-release",
      "inherits": "default-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "$env{QT_PREFIX}"
      },
      "environment": {
        "PATH": "C:/msys64/mingw64/bin;$penv{PATH}"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "default-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "default-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON"
      }
    },
    {
      "name": "gcc-debug",
      "inherits": "default-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "default-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],

  "buildPresets": [
    { "name": "build-mingw-debug",   "configurePreset": "mingw-debug" },
    { "name": "build-mingw-release", "configurePreset": "mingw-release" },
    { "name": "build-msvc-debug",    "configurePreset": "msvc-debug" },
    { "name": "build-msvc-release",  "configurePreset": "msvc-release" },
    { "name": "build-gcc-debug",     "configurePreset": "gcc-debug" },
    { "name": "build-clang-debug",   "configurePreset": "clang-debug" }
  ],

  "testPresets": [
    {
      "name": "test-mingw-debug",
      "configurePreset": "mingw-debug",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "TasqlyTests.*" } },
      "execution": { "noTestsAction": "error" },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QSG_RHI_BACKEND": "software",
        "CTEST_TEST_TIMEOUT": "0",
        "GTEST_PRINT_TIME": "1"
      }
    },
    {
      "name": "test-mingw-release",
      "configurePreset": "mingw-release",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "TasqlyTests.*" } },
      "execution": { "noTestsAction": "error" },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QSG_RHI_BACKEND": "software",
        "CTEST_TEST_TIMEOUT": "0",
        "GTEST_PRINT_TIME": "1"
      }
    },
    { "name": "test-msvc-debug",   "configurePreset": "msvc-debug" },
    { "name": "test-msvc-release", "configurePreset": "msvc-release" },
    { "name": "test-gcc-debug",    "configurePreset": "gcc-debug" },
    { "name": "test-clang-debug",  "configurePreset": "clang-debug" }
  ]
}
