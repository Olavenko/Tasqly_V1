' ------------------------------------------------------------
' 🎨 Corporate Dark Theme Overrides
' ------------------------------------------------------------

' 🌐 Fonts & Background
' White
skinparam defaultFontName "Segoe UI, Arial, Helvetica"
skinparam defaultFontSize 14
skinparam defaultFontColor #FFFFFF
' Black
skinparam backgroundColor #000000

' 🔀 Arrows (Flows)
' Purple
skinparam ArrowColor     #604CE0
skinparam ArrowThickness 3
' White
skinparam ArrowFontColor #FFFFFF
skinparam ArrowFontSize  12

' 🔲 Containers (Systems)
skinparam rectangle {
    ' White
    FontColor       #FFFFFF
    ' Black
    BackgroundColor #000000
    ' Blue
    BorderColor     #A6FFF9
}

' 🧩 Components / Classes
skinparam component {
    ' Black
    BackgroundColor #000000
    ' Light Red / Coral
    BorderColor     #FF6F5C
    ' White
    FontColor       #FFFFFF
}
skinparam class {
    ' Black
    BackgroundColor #000000
    ' Light Red / Coral
    BorderColor     #FF6F5C
    ' White
    FontColor       #FFFFFF
}

' 📦 Packages / Infra
skinparam package {
    ' Black
    BackgroundColor #000000
    ' Pink
    BorderColor     #7DFFBE
    ' White
    FontColor       #FFFFFF
}

' 🧑 Actors
skinparam actor {
    Style           awesome
    ' White
    FontColor       #FFFFFF
    ' Green
    BackgroundColor #00CE6A
    ' Green
    BorderColor     #00CE6A
}

' 🗄️ Database
skinparam database {
    ' Black
    BackgroundColor #000000
    ' Yellow
    BorderColor     #E0C200
    ' White
    FontColor       #FFFFFF
}

' 📑 Notes / Errors
skinparam note {
    ' Black
    BackgroundColor #000000
    ' Red
    BorderColor     #EB1B00
    ' White
    FontColor       #FFFFFF
}

' 📦 Activity Diagram
skinparam activity {
    ' Black
    BackgroundColor #000000
    ' Cyan / Sky Blue
    BorderColor     #4BE3FE
    ' White
    FontColor       #FFFFFF
}

' 📦 Sequence Diagram
skinparam sequence {
    ' Purple
    ArrowColor                #604CE0
    ' Dark Green
    LifeLineBorderColor       #246947
    ' Black
    LifeLineBackgroundColor   #000000
    ' Black
    ParticipantBackgroundColor #000000
    ' Light Red / Coral
    ParticipantBorderColor    #FF6F5C
    ' White
    ParticipantFontColor      #FFFFFF
}

' 📦 Use Case Diagram
skinparam usecase {
    ' Black
    BackgroundColor #000000
    ' Light Red / Coral
    BorderColor     #FF6F5C
    ' White
    FontColor       #FFFFFF
}

' 🚫 Shadows & Borders
skinparam shadowing   false
skinparam roundcorner 10
