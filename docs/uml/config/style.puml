' ------------------------------------------------------------
' 🎨 Corporate Dark Theme Overrides
' ------------------------------------------------------------

' 🌐 Fonts & Background
skinparam defaultFontName "Segoe UI, Arial, Helvetica"
skinparam defaultFontSize 14
skinparam defaultFontColor #E6EDF3
skinparam backgroundColor  #0D1117

' 🔀 Arrows (Flows)
skinparam ArrowColor       #58A6FF
skinparam ArrowThickness   2
skinparam ArrowFontColor   #E6EDF3
skinparam ArrowFontSize    12

' 🔲 Containers (Systems / rectangles)
skinparam rectangle {
    BackgroundColor #0D1117
    BorderColor     #58A6FF
    FontColor       #E6EDF3
    RoundCorner     8
}

' 🧩 Components / Classes
skinparam component {
    BackgroundColor #0D1117
    BorderColor     #A371F7
    FontColor       #E6EDF3
}
skinparam class {
    BackgroundColor #0D1117
    BorderColor     #A371F7
    FontColor       #E6EDF3
}

' 📦 Packages / Infra
skinparam package {
    BackgroundColor #0D1117
    BorderColor     #39C5CF
    FontColor       #E6EDF3
}

' 🧑 Actors
skinparam actor {
    Style           awesome
    BackgroundColor #3FB950
    BorderColor     #3FB950
    FontColor       #0D1117
}

' 🗄️ Database
skinparam database {
    BackgroundColor #0D1117
    BorderColor     #D29922
    FontColor       #E6EDF3
}

' 📑 Notes / Errors
skinparam note {
    BackgroundColor #161B22
    BorderColor     #F85149
    FontColor       #E6EDF3
}

' ▶ Activity Diagram
skinparam activity {
    BackgroundColor #0D1117
    BorderColor     #39C5CF
    FontColor       #E6EDF3
}

' ▶ Sequence Diagram
skinparam sequence {
    ArrowColor                  #58A6FF
    LifeLineBorderColor         #8B949E
    LifeLineBackgroundColor     #0D1117
    ParticipantBackgroundColor  #0D1117
    ParticipantBorderColor      #58A6FF
    ParticipantFontColor        #E6EDF3
    GroupBorderColor            #30363D
    GroupBackgroundColor        #0D1117
}

' ▶ Use Case Diagram
skinparam usecase {
    BackgroundColor #0D1117
    BorderColor     #A371F7
    FontColor       #E6EDF3
}

' 🚫 Shadows & Borders
skinparam shadowing   false
skinparam roundcorner 8
