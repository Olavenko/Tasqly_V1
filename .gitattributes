# ------------------------------------------------------------
# 🧱 Tasqly Project .gitattributes
# ------------------------------------------------------------
# 📌 Purpose: Normalize line endings, enforce UTF-8, improve GitHub linguist stats
# 🧱 Layer   : Infrastructure
# 👤 Author  : Mohamed Ali
# 🗓️ Updated : 2025-11-17
# ------------------------------------------------------------

# -------------------------------
# 🔄 Normalize line endings
# -------------------------------
* text=auto eol=lf
*.cpp text eol=lf
*.h   text eol=lf

# -------------------------------
# 🔄 Config files
# -------------------------------
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.clang-format text eol=lf
.clang-tidy text eol=lf

# -------------------------------
# 🌐 Default Encoding
# -------------------------------
* text working-tree-encoding=UTF-8

# -------------------------------
# 📂 C++ / Header files
# -------------------------------
*.cpp text diff=cpp linguist-language=C++
*.hpp text diff=cpp linguist-language=C++
*.h   text diff=cpp linguist-language=C++
*.cc  text diff=cpp linguist-language=C++
*.cxx text diff=cpp linguist-language=C++

# -------------------------------
# 📂 QML / Qt
# -------------------------------
*.qml   text linguist-language=QML
*.qrc   text
*.ui    text

# -------------------------------
# 📂 PlantUML
# -------------------------------
*.puml  text linguist-language=PlantUML
*.iuml  text linguist-language=PlantUML

# -------------------------------
# 📂 Docs
# -------------------------------
*.md    text linguist-language=Markdown
*.adoc  text
*.txt   text

# -------------------------------
# 📂 Scripts
# -------------------------------
*.sh    text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf

# -------------------------------
# 🧪 Tests
# -------------------------------
*.json  text
*.xml   text
*.yml   text
*.yaml  text

# -------------------------------
# 🚫 Binary files
# -------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bmp   binary
*.svg   text

*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary

*.zip   binary
*.tar   binary
*.gz    binary
*.7z    binary
*.rar   binary
*.jar   binary

# -------------------------------
# 🚦 GitHub Linguist Overrides
# -------------------------------
# Ignore vendored libraries (googletest, etc.)
external/* linguist-vendored

# Ignore IDE and build directories
.vs/ linguist-vendored
.idea/ linguist-vendored
.vscode/ linguist-vendored
.qt/ linguist-vendored
.build/ linguist-vendored
build*/ linguist-vendored

# Ignore docs and UML libs
docs/uml/libs/ linguist-vendored
docs/_build/ linguist-vendored
docs/generated/ linguist-vendored
docs/api/ linguist-vendored

# Mark documentation files
docs/uml/* linguist-documentation
*.md linguist-documentation
*.adoc linguist-documentation
*.txt linguist-documentation
